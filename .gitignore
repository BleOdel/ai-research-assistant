# Dependencies
node_modules/
.agents/skills/*/cli/node_modules/
bun.lock
*.lockb

# Bun / TypeScript build output
*.tsbuildinfo

# Personal research state and output — regenerated locally, never shared as-is.
# /synthesize writes into a per-topic subdirectory (reports/<topic_slug>/...), so
# these must be recursive (reports/**/*) - a flat reports/*.pdf pattern silently
# fails to ignore anything /synthesize actually produces.
# Deny-by-default. Enumerating extensions here has failed twice - /defend's
# defense_prep_*.md and /websearch's blog/<topic>/ were both shipped before a
# matching rule existed. A new output type must not be committable just because
# nobody thought to add a pattern for it, so everything under these directories is
# ignored and the few tracked framework files are re-included explicitly.
research/*
!research/.gitkeep
research_tracker.csv
reports/*
!reports/.gitkeep

# /websearch output: per-topic subdirectories are personal working data. The
# tracked template and README live directly in blog/, so only subdirectories
# and the discovery state file are ignored.
blog/*
!blog/README.md
!blog/template.html

# Personal identity/background documents — the folder structure and README stay
# tracked, but real CV/LinkedIn/publication files never should.
documents/cv/**
documents/linkedin/**
documents/publications/**
!documents/cv/.gitkeep
!documents/linkedin/.gitkeep
!documents/publications/.gitkeep

# LaTeX compile artifacts (report/ example stays tracked, its build junk doesn't)
report/*.aux
report/*.log
report/*.bbl
report/*.blg
report/*.out
report/*.pdf

# Python
__pycache__/
*.pyc

# Env / secrets
.env
.env.local

# OS
.DS_Store
